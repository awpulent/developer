<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.awpulent.flashrev.game.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btn_pause"
        style="@style/Widget.FlashRev.Button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:minHeight="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/pause"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/pause_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B0000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/paused"
            android:textAppearance="@style/TextAppearance.FlashRev.Title" />

        <Button
            android:id="@+id/btn_resume"
            style="@style/Widget.FlashRev.Button.Primary"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/resume" />

        <Button
            android:id="@+id/btn_restart"
            style="@style/Widget.FlashRev.Button"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/restart" />

        <Button
            android:id="@+id/btn_quit"
            style="@style/Widget.FlashRev.Button.Danger"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="@string/quit" />
    </LinearLayout>
</FrameLayout>
